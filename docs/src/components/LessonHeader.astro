---
import { getCollection } from "astro:content";

/**
 * Header of one tutorial lesson.
 *
 * Every lesson starts with the same three things, in the same place, so a reader
 * learns where to look:
 *   the promise    what you can do at the end of this lesson
 *   the position   which lesson this is, out of how many
 *   the time       how long the lesson takes
 *
 * It also carries the course outline and the ONE way back. A course lives in a
 * single sidebar entry, so Starlight's own previous/next links cannot work here:
 * they are built from the sidebar, and the sidebar does not list the lessons.
 * The outline row under the meta line is one segment for each lesson, each a
 * link, with the done ones and the current one filled. Both it and the back
 * link are read from the content collection instead of a list kept by hand, so
 * a renamed or inserted lesson cannot make them wrong.
 *
 * Usage:
 *   <LessonHeader
 *     lesson={3}
 *     of={9}
 *     minutes={20}
 *     promise="the desk answers from your tables, and cannot read another contract."
 *     scripts={["03_tools_read.sql"]}
 *     course="build-an-agent"
 *   />
 */
interface Props {
  /** Number of this lesson. */
  lesson: number;
  /** How many lessons the course has. */
  of: number;
  /** Reading and doing time, in minutes. */
  minutes: number;
  /**
   * What the reader can do at the end, as the end of "By the end of this
   * lesson, ...". Rendered as HTML, so <code>...</code> works. Markdown does
   * not: a prop is a plain string and no Markdown runs on it.
   */
  promise: string;
  /** Scripts this lesson runs, in order. Optional. */
  scripts?: string[];
  /**
   * Directory of this course under examples/ in the repository. The script
   * links point there. Defaults to the first course, so its lessons need no
   * change.
   */
  course?: string;
}

const {
  lesson,
  of,
  minutes,
  promise,
  scripts = [],
  course = "build-an-agent",
} = Astro.props;

const repoBase = `https://github.com/United-Codes/uc_ai/blob/main/examples/${course}/`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Every lesson of this course, in order. The file names are zero padded
// (01..09), so the id sorts into lesson order. The list feeds two things: the
// back link, and the outline under the meta row, so a reader in lesson 4 can see
// the seven titles and jump to one. Neither is kept by hand, so a renamed or
// inserted lesson cannot make them wrong.
const inCourse = await getCollection("docs", (entry) =>
  entry.id.startsWith(`tutorial/${course}/`),
);
const outline = inCourse
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((entry, index) => ({
    number: index + 1,
    title: entry.data.title,
    href: `${base}/${entry.id.replace(/\.mdx?$/, "")}/`,
  }));

// Where "back" goes. Lesson 1 has no previous lesson, so it returns to the list
// of tutorials. Every other lesson returns to the one before it, by name.
let backHref = `${base}/tutorial/`;
let backLabel = "All tutorials";

const previous = outline[lesson - 2];
if (lesson > 1 && previous) {
  backHref = previous.href;
  backLabel = previous.title;
}
---

<div class="lesson-header" data-lesson={lesson}>
  <a class="lesson-back" href={backHref}>
    <svg
      aria-hidden="true"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    <span>{backLabel}</span>
  </a>

  <p class="lesson-promise">
    <strong>By the end of this lesson, <span set:html={promise} /></strong>
  </p>

  <div class="lesson-meta">
    <span class="lesson-badge">Lesson {lesson} of {of}</span>
    <span class="lesson-time" aria-label={`About ${minutes} minutes`}>
      <svg
        aria-hidden="true"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      ~{minutes} min
    </span>

    {
      scripts.length > 0 && (
        <span class="lesson-scripts">
          Script:{" "}
          {scripts.map((file, i) => (
            <>{i > 0 ? <span>, </span> : null}<a href={`${repoBase}${file}`}>{file}</a></>
          ))}
        </span>
      )
    }
  </div>

  <nav class="lesson-outline" aria-label="Lessons of this course">
    <ol>
      {
        outline.map((item) => (
          <li>
            <a
              href={item.href}
              title={`Lesson ${item.number}: ${item.title}`}
              aria-current={item.number === lesson ? "page" : undefined}
              class:list={[{ "is-done": item.number < lesson }]}
            >
              <span class="sr-only">Lesson {item.number}: {item.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</div>

<style>
  /* The progress bar is the divider. A rule under it as well reads as a
     double rule, which looks like a mistake. */
  .lesson-header {
    margin: 0 0 2rem;
  }

  /* A button, not a sentence: it sits above the promise, reads as one tap target,
     and does not compete with the lesson title for attention. */
  .lesson-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.9rem;
    padding: 0.3rem 0.7rem 0.3rem 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.3;
    text-decoration: none;
    max-width: 100%;
  }

  .lesson-back:hover,
  .lesson-back:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  /* A long lesson title must not push the pill past the page edge. */
  .lesson-back span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lesson-back svg {
    flex: none;
  }

  .lesson-promise {
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-lg);
    line-height: 1.5;
    color: var(--sl-color-white);
  }

  .lesson-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .lesson-badge {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 600;
    white-space: nowrap;
  }

  /* A TRAILING separator, not a leading one. A ::before puts a lone dot at the
     start of a wrapped line; a ::after leaves it at the end of the line before. */
  .lesson-meta > *:not(:last-child)::after {
    content: "·";
    margin-left: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  /* The scripts item always wraps on a phone, so give it its own row and no
     separator at all. */
  @media (max-width: 30rem) {
    .lesson-scripts {
      flex-basis: 100%;
    }

    .lesson-meta > *:not(:last-child)::after {
      content: none;
      margin-left: 0;
    }
  }

  .lesson-time,
  .lesson-scripts {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .lesson-scripts {
    white-space: normal;
  }

  .lesson-scripts a {
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
  }

  /* The outline is the divider and the progress bar in one. Each segment is one
     lesson and a link to it. Done lessons and the current one are filled, so the
     row also reads as "how far am I". */
  .lesson-outline {
    margin-top: 0.9rem;
  }

  .lesson-outline ol {
    display: flex;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lesson-outline li {
    flex: 1;
    margin: 0;
  }

  .lesson-outline a {
    display: block;
    height: 4px;
    border-radius: 999px;
    background: var(--sl-color-gray-5);
    transition: background 0.15s ease;
  }

  .lesson-outline a.is-done {
    background: var(--sl-color-accent-low);
  }

  .lesson-outline a[aria-current="page"] {
    background: var(--sl-color-accent);
  }

  .lesson-outline a:hover,
  .lesson-outline a:focus-visible {
    background: var(--sl-color-accent-high);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
