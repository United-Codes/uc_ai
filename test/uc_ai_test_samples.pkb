-- one recorded response contains a literal '&'; keep SQLcl from treating it as a substitution variable
set define off

create or replace package body uc_ai_test_samples as
  -- @dblinter ignore(g-7210): generated fixture package, one literal per recorded sample; its length is the data

  -- GENERATED by scripts/generate_test_samples.sh from test/samples/**/*.json.
  -- Do not edit: change the JSON file and run the script (or `make generate`).

  function get(p_name in varchar2) return clob
  as
  begin
    case p_name
      when 'anthropic/1-simple-request' then
        return q'~{
  "model": "claude-3-5-haiku-latest",
  "max_tokens": 8192,
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "I have tomatoes, salad, potatoes, olives, and cheese. What can I cook with that?"
        }
      ]
    }
  ],
  "system": "You are an assistant helping users to get recipes. Please just list 3 possible dishe names without instructions."
}
~';

      when 'anthropic/1-simple-response' then
        return q'~{
  "model": "claude-3-5-haiku-20241022",
  "id": "msg_018m7e2uNqHh3zZ7GxHLTBXX",
  "type": "message",
  "role": "assistant",
  "content": [
    {
      "type": "text",
      "text": "Here are three possible dishes you could make with those ingredients:\n\n1. Greek Salad with Potato Croutons\n2. Mediterranean Potato and Tomato Bake\n3. Cheesy Olive and Potato Salad"
    }
  ],
  "stop_reason": "end_turn",
  "stop_sequence": null,
  "usage": {
    "input_tokens": 54,
    "cache_creation_input_tokens": 0,
    "cache_read_input_tokens": 0,
    "cache_creation": {
      "ephemeral_5m_input_tokens": 0,
      "ephemeral_1h_input_tokens": 0
    },
    "output_tokens": 56,
    "service_tier": "standard"
  }
}
~';

      when 'anthropic/4-structured-output-request' then
        return q'~{
  "model": "claude-haiku-4-5",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "What is the capital of France? Please respond with confidence."
        }
      ]
    }
  ],
  "output_config": {
    "format": {
      "type": "json_schema",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "title": "Response with confidence score",
        "required": [
          "response",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "response": {
            "type": "string",
            "description": "The generated response text"
          },
          "confidence": {
            "type": "number",
            "description": "Confidence score between 0 and 1. Must be at least 0. Must be at most 1."
          }
        }
      }
    }
  },
  "system": "You are a helpful assistant that provides accurate information.",
  "max_tokens": 8192
}
~';

      when 'anthropic/4-structured-output-response' then
        return q'~{
  "model": "claude-haiku-4-5-20251001",
  "id": "msg_011CeVBoeN18B2QGVMfXb4j4",
  "type": "message",
  "role": "assistant",
  "content": [
    {
      "type": "text",
      "text": "{\"response\": \"The capital of France is Paris.\", \"confidence\": 0.99}"
    }
  ],
  "stop_reason": "end_turn",
  "stop_sequence": null,
  "stop_details": null,
  "usage": {
    "input_tokens": 267,
    "cache_creation_input_tokens": 0,
    "cache_read_input_tokens": 0,
    "cache_creation": {
      "ephemeral_5m_input_tokens": 0,
      "ephemeral_1h_input_tokens": 0
    },
    "output_tokens": 22,
    "service_tier": "standard",
    "inference_geo": "not_available"
  }
}
~';

      when 'anthropic/5-reasoning-request' then
        return q'~{
  "model": "claude-sonnet-4-0",
  "thinking": {
    "type": "enabled",
    "budget_tokens": 2048
  },
  "max_tokens": 8192,
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Answer in one sentence. If there is a great filter, are we before or after it and why."
        }
      ]
    }
  ]
}
~';

      when 'anthropic/5-reasoniong-response' then
        return q'~{
  "model": "claude-sonnet-4-20250514",
  "id": "msg_01Mx795UDa7ToSLhXz3pkKVR",
  "type": "message",
  "role": "assistant",
  "content": [
    {
      "type": "thinking",
      "thinking": "The Great Filter is a concept from the Fermi Paradox that suggests there's some evolutionary step or challenge that prevents most life from becoming spacefaring civilizations. The question is asking whether humanity has already passed through this hypothetical filter or if we're approaching it.\n\nThere are arguments for both sides:\n\nArguments we're before it:\n- We haven't become a truly spacefaring civilization yet\n- We face existential risks like nuclear war, climate change, AI risks\n- The silence of the universe suggests most civilizations don't make it past some point\n- We're still relatively early in our technological development\n\nArguments we're after it:\n- The emergence of life itself might be extremely rare\n- The development of complex multicellular life took billions of years\n- Intelligence and technology development might be the rare steps\n- We've already survived many potential extinction events\n\nI think the most scientifically reasonable answer acknowledges the uncertainty but leans toward one interpretation. Many scientists and philosophers who study this topic suggest we're likely before it, given that we haven't achieved true interstellar civilization status and face many existential risks ahead.",
      "signature": ""
    },
    {
      "type": "text",
      "text": "We are most likely before the Great Filter, as our continued existence as a non-spacefaring civilization suggests the most dangerous evolutionary hurdle—likely related to technological self-destruction or the transition to becoming a sustainable interstellar species—still lies ahead of us."
    }
  ],
  "stop_reason": "end_turn",
  "stop_sequence": null,
  "usage": {
    "input_tokens": 57,
    "cache_creation_input_tokens": 0,
    "cache_read_input_tokens": 0,
    "cache_creation": {
      "ephemeral_5m_input_tokens": 0,
      "ephemeral_1h_input_tokens": 0
    },
    "output_tokens": 303,
    "service_tier": "standard"
  }
}
~';

