    }
    default {
        value: 450px
    }
)

customAttribute run_context_drift (
    apexlangName: runContextDrift
    attribute: 20
    name: Run Context Drift
    type: selectList
    appearance {
        attributeGroup: @runContext
        sequence: 200
    }
    default {
        value: ignore
    }
    dependingOn {
        attribute: @agent_run_context/component
        conditionType: isNotNull
    }
    help {
        helpText:
            ```
            <p>What to do when <strong>Agent Run Context</strong> resolves to different values than the ones this conversation is already bound to &mdash; typically because the user navigated to another record while the chat was open.</p>
            
            <p>UC AI binds the context on a conversation&rsquo;s first turn. A later turn may add a key, but changing one is refused: the persisted messages, and any memory files, were written under the original binding, so silently re-targeting them would expose one record&rsquo;s conversation to another.</p>
            
            <ul>
              <li><strong>Refuse the turn and explain why</strong> (default) &mdash; nothing is sent, and a notice above the composer tells the user the conversation is tied to different data. Safe: nothing is lost without the user choosing it.</li>
              <li><strong>Start a new conversation</strong> &mdash; the region silently opens a fresh conversation bound to the new values and sends the message there. Right for &ldquo;talk to this record&rdquo; pages; the visible history of the old conversation is gone, and there is no history UI to get it back.</li>
              <li><strong>Keep the original binding</strong> &mdash; the change is ignored and the conversation keeps answering under what its first turn bound. Matches how Agent Input Mapping stops applying after the first message.</li>
            </ul>
            
            <p>Only relevant when Agent Run Context is set. Adding a <em>new</em> key is never a conflict and is always allowed.</p>
            ```
    }

    entry error (
        sequence: 10
        display: error
        return: error
        help {
            helpText: Turn refused, red banner above the composer, optimistic bubble left standing
        }
    )

    entry ignore (
        sequence: 30
        display: ignore
        return: ignore
        help {
            helpText: Original binding frozen, exactly like agent_input_mapping after turn one
        }
    )

    entry newSession (
        sequence: 20
        display: new_session
        return: new_session
        help {
            helpText: Fresh conversation opened and bound to the new values; session_item updated
        }
    )

)

customAttribute session_init_code (
    apexlangName: sessionInitCode
    attribute: 7
    name: Session Init Code
    type: plsqlCode
    appearance {
        attributeGroup: @agent
        sequence: 70
    }
    help {
        helpText:
            ```
            <p>Optional. A PL/SQL block that runs <strong>inside the background scheduler job</strong> just before the agent executes, in the job's session.</p>
            <p>The scheduler job runs without an APEX session, so any context the agent depends on (e.g. <code>APP_USER</code>, workspace ID, custom application contexts) must be re-established here.</p>
            <p>Item references are resolved <strong>at request time</strong> (when the APEX session is still live) and inlined into the code before it's stored. Supported syntaxes:</p>
            <ul>
              <li><code>&APEX_ITEM.</code>: substituted natively by APEX.</li>
              <li><code>:APEX_ITEM</code>: substituted with a quoted SQL literal of the item's value. <em>Caveat:</em> matches anywhere, including inside string literals; prefer <code>&ITEM.</code> if your code embeds <code>:</code> inside strings.</li>
            </ul>
            ```
    }
    examples {
        examples:
            ```
            <pre>apex_session.attach(
              p_app_id      => :APP_ID,
              p_page_id     => :APP_PAGE_ID,
              p_session_id  => :APP_SESSION
            );
            
            -- or
            my_ctx_package.login(&APP_USER.)
            </pre>
            ```
    }
)

customAttribute session_item (
    apexlangName: sessionItem
    attribute: 3
    name: Session Item
    type: pageItem
    appearance {
        attributeGroup: @conversation
        sequence: 30
    }
    help {
        helpText:
            ```
            <p>Optional. The name of an APEX page item that should hold the AI chat <strong>session ID</strong>.</p>
            <p>When set:</p>
            <ul>
              <li>On region render, the chat will resume the session whose ID is stored in this item (if any).</li>
              <li>When the user starts a new conversation, the new session ID is written back to this item so it survives page submissions.</li>
            </ul>
            <p>Leave blank for ephemeral, in-memory-only sessions that reset on every page load.</p>
            ```
    }
    examples {
        examples: <code>P10_AI_SESSION_ID</code>
    }
)

customAttribute suggested_prompts (
    apexlangName: suggestedPrompts
    attribute: 18
    name: Suggested Prompts
    type: textarea
    appearance {
        attributeGroup: @conversation
        sequence: 180
    }
    help {
        helpText:
            ```
            <p>Example questions offered as clickable chips while the conversation is still empty. Clicking one sends it immediately, so a first-time user has something to try instead of a blank box.</p>
            
            <p>Enter <strong>one prompt per line</strong>. Surrounding spaces are trimmed and blank lines are ignored; commas and quotes are safe. Leave the attribute empty to show no chips.</p>
            
            <p>The chips show only while the transcript is empty and vanish as soon as the first message is sent &mdash; they are a starting point, not a menu. <strong>New chat</strong> empties the conversation, so they come back for the next one.</p>
            
            <p>Keep them short enough to read at a glance; long lines are still sent in full but wrap awkwardly in a narrow region.</p>
            ```
    }
    examples {
        examples:
            ```
            <pre>What is Oracle APEX?
            Write a SQL query example
            How do I debug a slow page?</pre>
            ```
    }
)

customAttribute thinking_animation (
    apexlangName: thinkingAnimation
    attribute: 14
    name: Thinking Animation
    type: selectList
    validation {
        required: true
    }
    appearance {
        attributeGroup: @appearance
        sequence: 140
    }
    default {
        value: dots
    }

    entry braille (
        sequence: 20
        display: Braille
        return: braille
        help {
            helpText: Single line of braille cells tracing a travelling wave
        }
    )

    entry dots (
        sequence: 10
        display: Dots
        return: dots
        help {
            helpText: Bouncing dots
        }
    )

    entry matrix (
        sequence: 40
        display: Matrix
        return: matrix
        help {
            helpText: 6 × 18 glyph cascade, columns desynced by a hash of the column index
        }
    )

    entry plasma (
        sequence: 30
        display: Plasma
        return: plasma
        help {
            helpText: 3 × 28 density-ramp field from summed sines — a band of energy flowing left→right
        }
    )

)

customAttribute thinking_detail (
    apexlangName: thinkingDetail
    attribute: 16
    name: Thinking Detail
    type: selectList
    validation {
        required: true
    }
    appearance {
        attributeGroup: @appearance
        sequence: 160
    }
    default {
        value: status
    }

    entry off (
        sequence: 20
        display: off
        return: off
        help {
            helpText: Nothing — the animation alone
        }
    )

    entry status (
        sequence: 10
        display: status
        return: status
        help {
            helpText: `Thinking…` plus elapsed seconds
        }
    )

    entry tools (
