list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry analyze-data-at-scale (
        label: Analyze Data at Scale
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 50
        }
        isCurrent {
            type: pages
            pages: 40
        }
        link {
            target: {
                page: 40
            }
        }
    )

    entry give-an-agent-a-memory (
        label: Give an Agent a Memory
        icon {
            imageIconCssClasses: fa-lightbulb-o
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: 20
        }
        link {
            target: {
                page: 20
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry put-an-agent-in-apex (
        label: Put an Agent in APEX
        icon {
            imageIconCssClasses: fa-comments-o
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: 10
        }
        link {
            target: {
                page: 10
            }
        }
    )

    entry secure-an-agent (
        label: Secure an Agent
        icon {
            imageIconCssClasses: fa-shield
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: 30
        }
        link {
            target: {
                page: 30
            }
        }
    )

)

